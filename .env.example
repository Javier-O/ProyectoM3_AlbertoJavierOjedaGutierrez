# Copia este archivo como ".env" y pega tu clave real (consíguela en Google AI Studio).
# El archivo ".env" está en .gitignore: nunca se sube a GitHub.
GEMINI_API_KEY=

# OPCIONAL: modelo de Gemini a usar. Si lo dejas vacío, se usa gemini-3.5-flash.
# Si Google retira un modelo, basta cambiar este valor (sin tocar el código).
GEMINI_MODEL=

# OPCIONAL: modelo de respaldo si el principal responde "saturado" (503).
# Si lo dejas vacío, se usa gemini-3.1-flash-lite.
GEMINI_FALLBACK_MODEL=
